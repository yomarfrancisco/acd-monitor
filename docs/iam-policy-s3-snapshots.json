{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBucketListOnRoot",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::acd-monitor-snapshots",
      "Condition": {
        "StringLike": { 
          "s3:prefix": ["snapshots/*"] 
        }
      }
    },
    {
      "Sid": "AllowObjectRW",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject", 
        "s3:DeleteObject",
        "s3:ListBucketMultipartUploads",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::acd-monitor-snapshots/snapshots/*"
    }
  ]
}
