{
  "name": "acd-monitor",
  "version": "1.0.0",
  "description": "Algorithmic Coordination Diagnostic (ACD) Platform",
  "private": true,
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "ui/cursor-dashboard",
    "packages/*"
  ],
  "scripts": {
    "ui:install": "cd ui/cursor-dashboard && npm install",
    "ui:dev": "cd ui/cursor-dashboard && npm run dev",
    "ui:build": "cd ui/cursor-dashboard && npm run build",
    "ui:start": "cd ui/cursor-dashboard && npm start",
    "health:proxy": "scripts/health-check.sh"
  },
  "devDependencies": {
    "@types/node": "^24.3.3"
  },
  "pnpm": {
    "allowedScripts": {
      "@tailwindcss/oxide": true
    }
  }
}