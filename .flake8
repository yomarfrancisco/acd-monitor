[flake8]
max-line-length = 100
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    build,
    dist,
    node_modules,
    ui/cursor-dashboard/node_modules,
    # legacy / experimental / generated (temporarily excluded)
    analysis/BTC/synthetic/,
    analytics/wave1/,
    analytics/wave2/,
    analytics/reader_checks/,
    artifacts/,
    backend/,
    cases/,
    experiments/,
    writer/,
    src/acd/demo/,
    src/acd/monitoring/,
    src/acd/vmm/,
    src/acd/data/quality_profiles*,
    test_*,
    run_*.py,
    simulate_canary_capture.py,
    trigger_canary_capture.py,
    scripts/,
    # exclude duplicate numbered files
    *\ 2.py,
    *\ 3.py,
    *\ 4.py,
    *\ 5.py,
    *\ 6.py,
    *\ 7.py,
    *\ 8.py,
    *\ 9.py,
    # exclude src/acd/analytics (analytical research code, not production)
    src/acd/analytics/,
    # exclude src/agent (experimental agent code)
    src/agent/