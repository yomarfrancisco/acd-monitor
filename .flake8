[flake8]
max-line-length = 100
select = B,C,E,F,W
extend-ignore = E203,W503
per-file-ignores =
    src/__init__.py: F401,F403
exclude =
    .git,
    .github,
    .venv,
    build,
    dist,
    artifacts,
    analysis,
    experiments,
    tests,                 # TEMP quarantine
    **/*\ *.py,            # files with spaces + numeric suffixes
    writer/parsers/*\ *.py